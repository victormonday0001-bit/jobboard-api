NODE_ENV=development
PORT=5000

# Database — Supabase users: PG_PORT=6543 and
# PG_USER=postgres.<project-ref> (see README)
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# JWT — generate each with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email — Brevo HTTP API (not SMTP). Key must start with xkeysib-
BREVO_API_KEY=
EMAIL_FROM=

# App
APP_NAME=JobBoard
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Uploads
MAX_CV_SIZE_MB=5
MAX_LOGO_SIZE_MB=2
UPLOADS_DIR=uploads